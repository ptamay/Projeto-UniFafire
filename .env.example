# Exemplo de configuração de ambiente
# Copie este arquivo para .env e altere os valores para produção

# Chave secreta para assinatura dos JWTs de sessão
# OBRIGATÓRIO: Deve ter no mínimo 32 caracteres
# Use entropia real (ex.: `openssl rand -base64 48`), não um identificador previsível.
JWT_SECRET="sua-chave-secreta-muito-longa-com-pelo-menos-32-caracteres-aqui"

# Perfil de ambiente (constitution §8) — TASK-060
# Valores: dev | production
# AUSENTE OU DESCONHECIDO = production. Só o literal exato "dev" relaxa controles.
# Em dev, §8 permite desligar lockout e rate limit. Nunca em produção.
APP_ENV="dev"

# Fuso da instituição, usado nos filtros e na exibição da trilha de auditoria — TASK-055
# Ausente = America/Recife. Para o bundle do cliente, use NEXT_PUBLIC_APP_TIMEZONE.
# APP_TIMEZONE="America/Recife"

# Caminho do banco SQLite. Ausente = keys.db na raiz do projeto.
# DB_PATH="keys.db"
