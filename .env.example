# Exemplo de configuração de ambiente
# Copie este arquivo para .env e altere os valores para produção

# Chave secreta para assinatura dos JWTs de sessão (constitution §2.1)
# OBRIGATÓRIO. Gere com:  openssl rand -base64 48
#
# O valor abaixo é PROPOSITALMENTE INVÁLIDO: `src/lib/secret-policy.ts` recusa
# qualquer segredo que contenha marcas de exemplo, e o processo não sobe com ele.
# Copiar este arquivo e subir falha alto, em vez de assinar toda sessão do
# sistema com uma chave que está publicada neste repositório.
#
# Também são recusados: menos de 32 caracteres, menos de 16 símbolos distintos
# (comprimento não é entropia) e formato de UUID, com ou sem sufixo.
JWT_SECRET="sua-chave-secreta-TROQUE-por-openssl-rand-base64-48"

# Perfil de ambiente (constitution §8) — TASK-060
# Valores: dev | production
# AUSENTE OU DESCONHECIDO = production. Só o literal exato "dev" relaxa controles.
# Em dev, §8 permite desligar lockout e rate limit. Nunca em produção.
APP_ENV="dev"

# Fuso da instituição, usado nos filtros e na exibição da trilha de auditoria — TASK-055
# Ausente = America/Recife. Para o bundle do cliente, use NEXT_PUBLIC_APP_TIMEZONE.
# APP_TIMEZONE="America/Recife"

# Conexão Postgres (ADR-012). Em produção, use a string do POOLER do Supabase
# em transaction mode — não a conexão direta: execução serverless devolve a
# conexão a cada transação, e o modo direto esgotaria o limite do plano.
# Local/teste: `npm run test:db:up` sobe o container e usa a porta 55432.
DATABASE_URL="postgresql://usuario:senha@host:6543/postgres"

