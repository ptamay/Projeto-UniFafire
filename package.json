{
  "name": "key-manager",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "node -e \"fs.rmSync('.next', {recursive:true,force:true})\" && next dev",
    "dev:safe": "node -e \"fs.rmSync('.next', {recursive:true,force:true})\" && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest",
    "test:e2e": "playwright test",
    "prepare": "husky",
    "tunnel": "npx cloudflared tunnel --url http://localhost:3000",
    "test:db:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:db:down": "docker compose -f docker-compose.test.yml down -v"
  },
  "dependencies": {
    "@ducanh2912/next-pwa": "^10.2.9",
    "@supabase/supabase-js": "^2.115.0",
    "bcryptjs": "^3.0.3",
    "jose": "^6.1.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "next": "16.3.4",
    "pg": "^8.23.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hot-toast": "^2.6.0",
    "zod": "^4.3.6"
  },
  "overrides": {
    "@babel/plugin-transform-modules-systemjs": "^7.29.4",
    "brace-expansion": "^2.0.3",
    "fast-uri": "^3.1.2",
    "flatted": "^3.4.2",
    "lodash": "^4.18.1",
    "picomatch": "^4.0.4",
    "postcss": "^8.5.15",
    "serialize-javascript": "^7.0.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/ui": "^4.1.9",
    "better-sqlite3": "^12.6.2",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "husky": "^9.1.7",
    "playwright": "^1.61.1",
    "typescript": "^5",
    "typescript-eslint": "^8.54.0",
    "vitest": "^4.1.9"
  }
}
